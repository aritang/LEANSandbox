\setsansfont[
  Path = /Users/tchaikovskiana/Library/Fonts/,
  Extension = .ttf,
  UprightFont = *,
  ItalicFont = {Product Sans Italic},
  BoldFont = {Product Sans Bold},
  BoldItalicFont = {Product Sans Bold Italic},
