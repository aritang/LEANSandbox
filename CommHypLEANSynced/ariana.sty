% ====================================================================================
% SECTION HEADERS ——————————————————————————————————————————————————————

\AtBeginSection[]{
  \begin{frame}[plain]
    \vspace{0.5cm}
    \begin{center}
      \colorbox{lightbarbiepink}{%
        \hspace{1.5em}%
        \parbox{0.85\linewidth}{
          \centering
          \vspace{0.8em}
          {\usebeamerfont{title}\color{deeptextgray}\secname}
          \vspace{0.8em}
        }%
        \hspace{1.5em}%
      }
    \end{center}
  \end{frame}
}

\AtBeginSubsection[]{
  \begin{frame}[plain]
    \centering
    \vspace{1cm}
    {\usebeamerfont{frametitle}\color{deeptextgray}\subsecname}
    \vspace{0.5cm}
    \par
  \end{frame}
}

% ====================================================================================
% CODE BLOCKS (minted, dark) ——————————————————————————————————————————————
% Requires -shell-escape and Pygments. Every \begin{minted}...\end{minted}
% is wrapped in a rounded dark box with a pink accent rule.

\setmonofont{Menlo}[Scale=MatchLowercase] % has ∀ → ℝ ∑ μ π for Lean code

\RequirePackage{minted}
\RequirePackage[most]{tcolorbox}

\xdefinecolor{codebg}{RGB}{40, 42, 54}      % dracula background
\xdefinecolor{codefg}{RGB}{248, 248, 242}   % dracula foreground

\setminted{
  style=dracula,
  fontsize=\scriptsize,
  breaklines,
  breaksymbolleft={},
  escapeinside=§§,
  mathescape,
}

\tcbset{
  arianacode/.style={
    enhanced, breakable=false,
    colback=codebg, colframe=codebg, coltext=codefg,
    arc=3pt, boxrule=0pt,
    left=7pt, right=6pt, top=4pt, bottom=4pt,
    before skip=4pt, after skip=6pt,
    borderline west={2pt}{0pt}{barbiepink},
  }
}

\BeforeBeginEnvironment{minted}{\begin{tcolorbox}[arianacode]}
\AfterEndEnvironment{minted}{\end{tcolorbox}}

% Inline code: \code{...} as a small dark pill
\newtcbox{\code}{on line, colback=codebg, colframe=codebg, coltext=codefg,
  arc=2pt, boxrule=0pt, left=2pt, right=2pt, top=1pt, bottom=1pt,
  fontupper=\ttfamily\footnotesize}

\mode<all>